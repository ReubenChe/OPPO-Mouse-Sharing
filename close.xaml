<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="关闭提醒" Width="478" Height="254" WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
 Background="White" FontFamily="Microsoft YaHei UI" Foreground="#14171B" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
 <Border BorderBrush="#DCDEE2" BorderThickness="1" Padding="24,21,24,22">
  <Grid><Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition/><RowDefinition Height="37"/><RowDefinition Height="42"/></Grid.RowDefinitions>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>
    <Image x:Name="DialogBrandMark" Width="25" Height="25" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality"/>
    <TextBlock Grid.Column="1" Text="关闭键鼠共享助手？" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
    <Button x:Name="CloseX" Grid.Column="2" Content="×" ToolTip="取消关闭" IsCancel="True" Style="{StaticResource SoftButton}" FontSize="22" Padding="0" Height="28" Background="#F3F3F3" BorderThickness="0" Foreground="#74787F"/>
   </Grid>
   <TextBlock x:Name="CloseDescription" Grid.Row="1" Text="收起至托盘可继续共享，退出将停止当前共享。" FontSize="12" Foreground="#85888D" Margin="0,15,0,16" TextWrapping="Wrap"/>
   <CheckBox x:Name="RememberMinimize" Grid.Row="2" Content="以后关闭时直接最小化到托盘，不再提醒" Style="{StaticResource AccentCheckBox}" VerticalAlignment="Top"/>
   <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Button x:Name="MinimizeChoice" Content="最小化到托盘" Style="{StaticResource PrimaryButton}" Background="#0066FF" BorderBrush="#0066FF" Foreground="White" IsDefault="True" Padding="8,9"/>
    <Button x:Name="ExitChoice" Grid.Column="2" Content="停止共享并退出" Style="{StaticResource PrimaryButton}" Background="#F3F3F3" BorderBrush="#F3F3F3" Padding="8,9"/>
   </Grid>
  </Grid>
 </Border>
</Window>

<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="软件更新" Width="510" SizeToContent="Height" MaxHeight="560" WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" ShowInTaskbar="False"
 Background="Transparent" FontFamily="Microsoft YaHei UI" Foreground="#14171B" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
 <Border Background="White" BorderBrush="#DCDEE2" BorderThickness="1" CornerRadius="12" Padding="24,21,24,22">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>
    <Image x:Name="DialogBrandMark" Width="25" Height="25" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality"/>
    <TextBlock x:Name="DialogTitle" Grid.Column="1" Text="软件更新" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
    <Button x:Name="CloseX" Grid.Column="2" Content="×" ToolTip="关闭" IsCancel="True" Style="{StaticResource SoftButton}" FontSize="22" Padding="0" Height="28" Background="#F3F3F3" BorderThickness="0" Foreground="#74787F"/>
   </Grid>
   <ScrollViewer Grid.Row="1" MaxHeight="300" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,17,0,0">
    <TextBlock x:Name="DialogMessage" FontSize="13" Foreground="#525B66" TextWrapping="Wrap" LineHeight="21"/>
   </ScrollViewer>
   <TextBlock x:Name="DialogHint" Grid.Row="2" Text="更新时助手将退出，停止由助手启动的共享，然后重新启动。" FontSize="12" Foreground="#85888D" TextWrapping="Wrap" Margin="0,16,0,0" Visibility="Collapsed"/>
   <Grid Grid.Row="3" Margin="0,16,0,0" Height="42">
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Button x:Name="CancelChoice" Content="暂不更新" Style="{StaticResource PrimaryButton}" Background="#F3F3F3" BorderBrush="#F3F3F3" Padding="8,9"/>
    <Button x:Name="ConfirmChoice" Grid.Column="2" Content="确定" Style="{StaticResource PrimaryButton}" Background="#0066FF" BorderBrush="#0066FF" Foreground="White" IsDefault="True" Padding="8,9"/>
   </Grid>
  </Grid>
 </Border>
</Window>

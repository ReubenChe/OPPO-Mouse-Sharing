<?xml version='1.0' encoding='utf-8'?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="键鼠共享助手" Width="680" Height="588" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen" Background="#EFF0F1" FontFamily="Microsoft YaHei UI" Foreground="#14171B" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
 <Window.Resources>
  <Style x:Key="SoftButton" TargetType="Button">
   <Setter Property="Cursor" Value="Hand" /><Setter Property="FontSize" Value="13" />
   <Setter Property="BorderThickness" Value="1" /><Setter Property="Padding" Value="14,10" />
   <Setter Property="Background" Value="White" /><Setter Property="BorderBrush" Value="#E2E3E5" /><Setter Property="Foreground" Value="#65696F" />
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.87" /></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.68" /></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderThickness" Value="2" /></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.5" /></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource SoftButton}">
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="PrimarySurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="23" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="PrimarySurface" Property="Opacity" Value="0.9" /></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="PrimarySurface" Property="Opacity" Value="0.7" /></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="PrimarySurface" Property="BorderThickness" Value="2" /></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="PrimarySurface" Property="Opacity" Value="0.5" /></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="AccentCheckBox" TargetType="CheckBox">
   <Setter Property="Cursor" Value="Hand" /><Setter Property="FontSize" Value="12" /><Setter Property="Foreground" Value="#65696F" />
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
    <StackPanel Orientation="Horizontal">
     <Border x:Name="CheckSurface" Width="16" Height="16" CornerRadius="4" Background="White" BorderBrush="#BABEC4" BorderThickness="1" VerticalAlignment="Center">
      <Path x:Name="Tick" Data="M 3,7 L 6,10 L 11,4" Stroke="White" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed" />
     </Border>
     <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center" />
    </StackPanel>
    <ControlTemplate.Triggers>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="CheckSurface" Property="Background" Value="#0066FF" /><Setter TargetName="CheckSurface" Property="BorderBrush" Value="#0066FF" /><Setter TargetName="Tick" Property="Visibility" Value="Visible" /></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CheckSurface" Property="BorderBrush" Value="#0066FF" /><Setter TargetName="CheckSurface" Property="BorderThickness" Value="2" /></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Grid Margin="28,22,28,20">
  <Grid.RowDefinitions><RowDefinition Height="142" /><RowDefinition Height="16" /><RowDefinition Height="244" /><RowDefinition Height="64" /><RowDefinition Height="*" /></Grid.RowDefinitions>
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="244" /><ColumnDefinition Width="24" /><ColumnDefinition /></Grid.ColumnDefinitions>
   <StackPanel>
    <StackPanel Orientation="Horizontal" Margin="0,0,0,1">
     <Image x:Name="BrandMark" Width="34" Height="34" Margin="0,0,10,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
     <!-- 中文字形的可见中心略低于行框中心，向上微调以与 Logo 视觉居中。 -->
     <TextBlock Text="键鼠共享" FontSize="26" FontWeight="SemiBold" VerticalAlignment="Center">
      <TextBlock.RenderTransform><TranslateTransform Y="-2" /></TextBlock.RenderTransform>
     </TextBlock>
    </StackPanel>
    <Border x:Name="DeviceCard" Background="#F7F7F7" BorderBrush="#E4E4E4" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,13,16,0">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition /></Grid.ColumnDefinitions>
      <Viewbox Width="16" Height="25" HorizontalAlignment="Left" VerticalAlignment="Center">
       <Canvas Width="16" Height="25"><Rectangle Width="15" Height="24" RadiusX="3" RadiusY="3" Stroke="#666E7A" StrokeThickness="1.3" /><Line X1="6" Y1="20.5" X2="10" Y2="20.5" Stroke="#666E7A" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" /></Canvas>
      </Viewbox>
      <StackPanel Grid.Column="1">
       <TextBlock x:Name="DeviceName" Text="正在检测手机" FontSize="14" FontWeight="SemiBold" Foreground="#85888D" TextTrimming="CharacterEllipsis" />
       <TextBlock x:Name="DeviceMethod" Text="读取连接信息…" FontSize="11" Foreground="#85888D" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
      </StackPanel>
     </Grid>
    </Border>
   </StackPanel>
   <Border Grid.Column="1" Width="1" Background="#DDDFE2" Margin="0,3,0,20" />
   <Grid x:Name="HeaderStatus" Grid.Column="2" Margin="5,4,0,0">
    <Grid.RowDefinitions><RowDefinition Height="42" /><RowDefinition Height="42" /><RowDefinition Height="52" /></Grid.RowDefinitions>
    <StackPanel>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="78" /><ColumnDefinition Width="15" /><ColumnDefinition /></Grid.ColumnDefinitions>
      <TextBlock Text="共享状态" Foreground="#85888D" FontSize="11" VerticalAlignment="Center" />
      <Ellipse x:Name="StatusDot" Grid.Column="1" Width="6" Height="6" Fill="#94A1B2" VerticalAlignment="Center" HorizontalAlignment="Left" />
      <TextBlock x:Name="StatusTitle" Grid.Column="2" Text="尚未启用" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
     </Grid>
     <TextBlock x:Name="StatusDetail" Text="选择方向后启用共享。" FontSize="11" Foreground="#85888D" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
    </StackPanel>
    <StackPanel Grid.Row="1">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="78" /><ColumnDefinition Width="15" /><ColumnDefinition /></Grid.ColumnDefinitions>
      <TextBlock Text="OPPO 互联" Foreground="#85888D" FontSize="11" VerticalAlignment="Center" />
      <Ellipse x:Name="ConnectionDot" Grid.Column="1" Width="6" Height="6" Fill="#94A1B2" VerticalAlignment="Center" HorizontalAlignment="Left" />
      <TextBlock x:Name="ConnectionTitle" Grid.Column="2" Text="正在检测…" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
     </Grid>
     <TextBlock x:Name="ConnectionDetail" Text="正在查询手机连接状态。" FontSize="11" Foreground="#85888D" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
    </StackPanel>
   <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="78" /><ColumnDefinition Width="15" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="手机位置" FontSize="11" Foreground="#85888D" VerticalAlignment="Center" /><Border Grid.Column="2" Background="#E4E5E7" CornerRadius="9" Padding="3" Height="42" VerticalAlignment="Center" x:Name="DirectionSelector">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="3" /><ColumnDefinition /></Grid.ColumnDefinitions>
     <Button x:Name="LeftButton" Content="←  左侧" Style="{StaticResource SoftButton}" FontSize="12" Padding="8,7" AutomationProperties.Name="手机在左侧" />
     <Button x:Name="RightButton" Grid.Column="2" Content="右侧  →" Style="{StaticResource SoftButton}" FontSize="12" Padding="8,7" AutomationProperties.Name="手机在右侧" />
    </Grid>
   </Border>
  </Grid></Grid>
  </Grid>
  <Border Grid.Row="2" Background="White" BorderBrush="#E5E6E8" BorderThickness="1" CornerRadius="14">
   <Viewbox Stretch="Uniform" Margin="10,20,10,18"><Canvas x:Name="DeviceLayout" Width="516" Height="170">
    <Ellipse Canvas.Left="167" Canvas.Top="144" Width="183" Height="9" Fill="#F1F2F3" />
    <Border Canvas.Left="174" Canvas.Top="29" Width="168" Height="104" Background="#30343B" BorderBrush="#24282E" BorderThickness="1" CornerRadius="8" Padding="5">
     <Border Background="#FAFAFB" CornerRadius="4"><Grid>
      <Grid.RowDefinitions><RowDefinition Height="14" /><RowDefinition /></Grid.RowDefinitions>
      <Border Background="#F0F1F3" CornerRadius="4,4,0,0"><Rectangle Width="28" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="#D8DCE1" HorizontalAlignment="Left" Margin="7,0,0,0" /></Border>
      <Grid Grid.Row="1"><Path Data="M 0,0 L 0,25 L 6,19 L 11,30 L 16,28 L 11,17 L 21,17 Z" Fill="#0066FF" Stroke="White" StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8,0,0,0" /></Grid>
     </Grid></Border>
    </Border>
    <Path Data="M 249,133 L 267,133 L 270,145 L 246,145 Z" Fill="#D0D3D8" /><Rectangle Canvas.Left="232" Canvas.Top="145" Width="52" Height="4" RadiusX="2" RadiusY="2" Fill="#B8BEC6" />
    <TextBlock Canvas.Left="244" Canvas.Top="155" Text="电脑" FontSize="10" Foreground="#85888D" />
    <Path x:Name="Connector" Stroke="#0066FF" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
    <Border x:Name="PhoneFrame" Canvas.Top="40" Width="52" Height="105" Background="#30343B" BorderBrush="#20242A" BorderThickness="1" CornerRadius="9" Padding="3">
     <Border Background="#FAFBFC" CornerRadius="6"><Grid>
      <Border Width="13" Height="3" CornerRadius="0,0,3,3" Background="#AEB4BC" VerticalAlignment="Top" />
      <Border Width="27" Height="35" CornerRadius="7" Background="#EFF5FF" BorderBrush="#DBE8FC" BorderThickness="1"><Path Data="M 0,0 L 0,13 L 3,10 L 6,16 L 9,14 L 6,8 L 12,8 Z" Fill="#0066FF" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
      <Rectangle Width="14" Height="2" RadiusX="1" RadiusY="1" Fill="#BBC1CA" VerticalAlignment="Bottom" Margin="0,0,0,5" />
     </Grid></Border>
    </Border>
    <TextBlock x:Name="PhoneCaption" Canvas.Top="155" Width="70" Text="手机" TextAlignment="Center" FontSize="10" Foreground="#85888D" />
   </Canvas></Viewbox>
  </Border>
  <Button x:Name="ShareButton" Grid.Row="3" Style="{StaticResource PrimaryButton}" Background="#0066FF" BorderBrush="#0066FF" Foreground="White" FontSize="15" FontWeight="SemiBold" Content="启用共享" Margin="0,15,0,0" />
  <TextBlock x:Name="DirectionHint" Grid.Row="4" FontSize="11" Foreground="#85888D" TextAlignment="Center" VerticalAlignment="Center" Margin="0,7,0,0" />
 </Grid>
</Window>

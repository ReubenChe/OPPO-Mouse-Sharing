<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="设置" Width="600" Height="650" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
 Background="#EFF0F1" FontFamily="Microsoft YaHei UI" Foreground="#14171B" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
 <Grid Margin="24,20,24,18">
  <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/><RowDefinition Height="94"/></Grid.RowDefinitions>
  <TextBlock Text="设置" FontSize="22" FontWeight="SemiBold" />
  <TabControl x:Name="SettingsTabs" Grid.Row="1" Background="White" BorderBrush="#E2E3E5" Padding="10">
   <TabControl.Resources>
    <Style TargetType="TabItem">
     <Setter Property="Foreground" Value="#666A70"/><Setter Property="FontSize" Value="13"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="22,8"/>
     <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
      <Border x:Name="TabSurface" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}" Margin="2">
       <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsSelected" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="White"/><Setter TargetName="TabSurface" Property="BorderBrush" Value="#0066FF"/><Setter Property="Foreground" Value="#0066E6"/></Trigger>
       <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TabSurface" Property="BorderThickness" Value="2"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate></Setter.Value></Setter>
    </Style>
   </TabControl.Resources>
   <TabControl.Template>
    <ControlTemplate TargetType="TabControl">
     <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border Background="#E4E5E7" CornerRadius="9" HorizontalAlignment="Left" Padding="2"><TabPanel IsItemsHost="True"/></Border>
      <Border Grid.Row="1" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="10" Margin="0,12,0,0">
       <ContentPresenter ContentSource="SelectedContent" Margin="{TemplateBinding Padding}"/>
      </Border>
     </Grid>
    </ControlTemplate>
   </TabControl.Template>
   <TabItem Header="常规" x:Name="GeneralTab">
    <StackPanel Margin="10,18,10,0">
     <Border Background="#F7F8FA" BorderBrush="#E2E3E5" BorderThickness="1" CornerRadius="8" Padding="16,18">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="58"/></Grid.ColumnDefinitions>
       <StackPanel VerticalAlignment="Center"><TextBlock Text="开机自启动" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="登录 Windows 后在托盘中运行" FontSize="11" Foreground="#85888D" Margin="0,7,0,0"/></StackPanel>
       <CheckBox x:Name="StartupSwitch" Grid.Column="1" Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.Name="开机自启动" />
      </Grid>
     </Border>
     <Border Background="#F7F8FA" BorderBrush="#E2E3E5" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,12,0,0">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <StackPanel VerticalAlignment="Center"><TextBlock Text="软件更新" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="从 GitHub Releases 检查新版本" FontSize="11" Foreground="#85888D" Margin="0,7,0,0"/></StackPanel>
       <Button x:Name="CheckUpdateButton" Grid.Column="1" Content="检查更新" Style="{StaticResource SoftButton}" Padding="12,7" VerticalAlignment="Center"/>
      </Grid>
     </Border>
     <TextBlock x:Name="SettingsFeedback" Text="设置自动保存" FontSize="11" Foreground="#85888D" Margin="1,12,1,8" TextWrapping="Wrap" />
    </StackPanel>
   </TabItem>
   <TabItem Header="使用帮助" x:Name="HelpTab">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel Margin="12,16,16,12">
      <TextBlock Text="新版 OPPO 互联适配指南" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/>
      <TextBlock Text="适用于版本号大于等于 17.100.10 的 OPPO 互联客户端：助手 -- ”打开 OPPO 互联屏幕协同设置”入口。目前已验证 17.100.10，其他更高版本尚未实机验证。" TextWrapping="Wrap" FontSize="12" Foreground="#525B66" Margin="0,9,0,12"/>
      <TextBlock Text="1  确认处理器" FontWeight="SemiBold" FontSize="13"/>
      <TextBlock x:Name="CpuHint" TextWrapping="Wrap" FontSize="12" Margin="0,5,0,12"/>
      <TextBlock Text="2  启用新版入口" FontWeight="SemiBold" FontSize="13"/>
      <TextBlock Text="AMD：以管理员身份打开 PowerShell，复制并运行下面的命令：" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,4"/>
      <TextBox x:Name="AmdCommand" Text="New-Item -Path 'HKLM:\SOFTWARE\Classes\xiao-hui-oppo-mouse-sharing' -Force" IsReadOnly="True" TextWrapping="Wrap" Padding="8" FontSize="11" Background="#F3F5F8" BorderBrush="#DDE2E8"/>
      <TextBlock Text="Intel：客户端检测的是当前用户的应用包注册项。下方操作尚未在 Intel 电脑实机验证；如果提示拒绝访问或没有生效，请勿修改权限，保留原有共享功能并反馈给我。" TextWrapping="Wrap" FontSize="12" Margin="0,10,0,4"/>
      <TextBox x:Name="IntelCommand" Text="New-Item -Path 'HKCU:\Software\Classes\Local Settings\Software\Microsoft\Windows\CurrentVersion\AppModel\Repository\Packages\AD2F1837.19285F10D180-oppo-mouse-sharing' -Force" IsReadOnly="True" TextWrapping="Wrap" Padding="8" FontSize="11" Background="#F3F5F8" BorderBrush="#DDE2E8"/>
      <TextBlock Text="3  打开屏幕协同" FontWeight="SemiBold" FontSize="13" Margin="0,12,0,0"/>
      <TextBlock Text="打开 OPPO 互联并连接一台手机，然后在助手主页点击“打开 OPPO 互联屏幕协同设置”。关闭原厂设置面板后，可在协同页面启动、停止共享或拖动设备调整方向。" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0"/>
      <TextBlock Text="提示：新助手首页连接状态与“自动共享”依赖 SDK 可用且仅支持一台设备，同时连接多台手机时，请先仅保留一台。" TextWrapping="Wrap" FontSize="12" Foreground="#805E21" Margin="0,10,0,0"/>
     </StackPanel>
    </ScrollViewer>
   </TabItem>
  </TabControl>
  <Grid Grid.Row="2" Margin="2,12,0,0">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel VerticalAlignment="Center">
    <TextBlock FontSize="12" Foreground="#3D424A"><Run x:Name="AppVersion" Text="v1.4.5" FontWeight="SemiBold"/><Run Text="    @Reuben"/><Run Text="    酷安 UID：32493969"/></TextBlock>
    <TextBlock Text="邮箱：reubenche@outlook.com" FontSize="11" Foreground="#85888D" Margin="0,7,0,0"/>
   </StackPanel>
   <Button x:Name="GithubButton" Grid.Column="1" Width="38" Height="38" VerticalAlignment="Center" Margin="8,0,10,0" Style="{StaticResource SoftButton}" Padding="5" ToolTip="打开 GitHub 项目主页" AutomationProperties.Name="打开 GitHub 项目主页">
    <Viewbox Width="20" Height="20"><Canvas Width="24" Height="24"><Path Fill="#30343B" Data="M12,0.3 C5.37,0.3 0,5.67 0,12.3 C0,17.6 3.44,22.1 8.21,23.69 C8.81,23.8 9.03,23.43 9.03,23.11 L9.02,20.88 C5.67,21.61 4.97,19.46 4.97,19.46 C4.42,18.07 3.63,17.7 3.63,17.7 C2.54,16.95 3.72,16.97 3.72,16.97 C4.92,17.05 5.55,18.2 5.55,18.2 C6.62,20.03 8.36,19.5 9.05,19.19 C9.15,18.42 9.47,17.89 9.81,17.59 C7.14,17.29 4.33,16.26 4.33,11.66 C4.33,10.35 4.8,9.28 5.57,8.44 C5.45,8.14 5.03,6.92 5.69,5.27 C5.69,5.27 6.7,4.95 8.99,6.5 C9.95,6.23 10.98,6.1 12,6.09 C13.02,6.1 14.05,6.23 15.01,6.5 C17.3,4.95 18.31,5.27 18.31,5.27 C18.97,6.92 18.55,8.14 18.43,8.44 C19.2,9.28 19.67,10.35 19.67,11.66 C19.67,16.27 16.85,17.28 14.17,17.58 C14.6,17.95 14.99,18.69 14.99,19.82 L14.97,23.11 C14.97,23.43 15.19,23.81 15.8,23.69 C20.56,22.1 24,17.6 24,12.3 C24,5.67 18.63,0.3 12,0.3 Z"/></Canvas></Viewbox>
   </Button>
   <Button x:Name="SettingsDone" Grid.Column="2" Content="完成" VerticalAlignment="Center" Width="88" Style="{StaticResource SoftButton}" Padding="12,7" Background="White" IsDefault="True" IsCancel="True" />
  </Grid>
 </Grid>
</Window>

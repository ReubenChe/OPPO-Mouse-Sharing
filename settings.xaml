<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="设置" Width="460" Height="310" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
 Background="#EFF0F1" FontFamily="Microsoft YaHei UI" Foreground="#14171B" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
 <Grid Margin="24,20,24,18">
  <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="100"/><RowDefinition Height="*"/><RowDefinition Height="36"/></Grid.RowDefinitions>
  <TextBlock Text="设置" FontSize="22" FontWeight="SemiBold" />
  <Border Grid.Row="1" Background="White" BorderBrush="#E2E3E5" BorderThickness="1" CornerRadius="8" Padding="16,18">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="58"/></Grid.ColumnDefinitions>
    <StackPanel VerticalAlignment="Center"><TextBlock Text="开机自启动" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="登录 Windows 后在托盘中运行" FontSize="11" Foreground="#85888D" Margin="0,7,0,0"/></StackPanel>
    <CheckBox x:Name="StartupSwitch" Grid.Column="1" Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.Name="开机自启动" />
   </Grid>
  </Border>
  <TextBlock x:Name="SettingsFeedback" Grid.Row="2" Text="设置自动保存" FontSize="11" Foreground="#85888D" Margin="1,12,1,8" TextWrapping="Wrap" />
  <Button x:Name="SettingsDone" Grid.Row="3" Content="完成" HorizontalAlignment="Right" Width="88" Style="{StaticResource SoftButton}" Padding="12,7" Background="White" IsDefault="True" IsCancel="True" />
 </Grid>
</Window>
